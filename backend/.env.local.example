# 复制为 backend/.env.local 后填写密码；backend/.env.local 已被 Git 忽略。
#
# 这是**本地配置的唯一来源**：同一个文件既供 docker compose 创建容器（基础设施键），
# 也由进程入口注入 process.env 供应用读取（应用键）。合并前是 backend/.env +
# backend/config.local.yaml 两个文件，两处口令靠注释保持一致，已取消。
#
# 应用键都有对应环境变量名，见 src/infra/config/config.ts；生产由部署平台注入，不需要本文件。

# ── 基础设施（docker compose 插值；仅 make infra-* 与集成测试使用）────────
# 多工作区同时启动时，为每个工作区设置不同的项目名和宿主机端口。
COMPOSE_PROJECT_NAME=red_bean

POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=red_bean
POSTGRES_PORT=5432

REDIS_PASSWORD=
REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── 应用（dotenv 注入 process.env；应用启动时读取）────────────────────────
DATABASE_URL=postgres://admin:@localhost:5432/red_bean?sslmode=disable
REDIS_URL=redis://:@localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET=red-bean-nian-gao

JWT_SECRET=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 开发账号：仅在 SERVER_ENV=local 时用于本地登录
DEV_USER_USERNAME=admin
DEV_USER_PASSWORD=
DEV_USER_DISPLAY_NAME=管理员
DEV_USER_EMAIL=admin@local.dev